/target
Cargo.lock

# Cargo build dirs for the per-channel runners (rust / cli are their
# own isolated workspaces under runners/).
**/target/

# Inputs snapshot DATA is not tracked: fixtures/manifest.json (tracked) pins
# one immutable snapshot in the private empyrean-data bucket, and
# scripts/inputs.py materializes + sha256-verifies the four product
# directories here. The per-directory READMEs and the local, never-tracked
# walk manifest (fixtures/windows.json) stay out of the snapshot. The
# materialized MANIFEST.json (the per-file manifest, fetched beside the data)
# is not tracked either. Contract: fixtures/README.md.
fixtures/psv/*
!fixtures/psv/README.md
fixtures/psv-radar/*
!fixtures/psv-radar/README.md
fixtures/horizons/*
fixtures/sbdb/*
fixtures/MANIFEST.json

# Compiled C-channel runner binary — `make -C runners/c` output.
runners/c/runner

# External-runner build artifacts (find_orb and OpenOrb both build from source via setup.sh)
runners/findorb/build/
runners/findorb/install/
runners/oorb/build/
runners/oorb/install/
# layup: its data directory, staged from the registered kernel set by
# runners/layup/stage_data.py (links + derived files, never tracked). build/
# held the upstream clone before setup.sh pinned the PyPI release.
runners/layup/data/
runners/layup/build/
# layup's LayupLogger writes timestamped log/err files to the CWD (repo root
# when invoked via `make run-layup` / `layup-bootstrap`); never track them.
layup-*.log
layup-*.err

# Per-runner Python venvs (each .venv has its own auto-generated
# .gitignore but be explicit so a stray `git add .` doesn't pull
# in CACHEDIR.TAG / pyvenv.cfg).
runners/*/.venv/

# jorbit's runner-private astropy download cache: the registered set's DE440
# and SB441-N16, staged under jorbit's URL keys by runners/jorbit/jorbit_offline.py.
runners/jorbit/.astropy-cache/

# Python bytecode caches that pop up when the runners are imported
# directly (e.g. for smoke-testing helpers without going through the
# venv entry point).
runners/*/__pycache__/
runners/*/tests/__pycache__/

# Validation artifacts produced by runners (output JSONs / reports).
runners/*/results/

# Channel outputs and accumulated baselines — regenerated by `make run`,
# carried out-of-band.
results/

# macOS Finder metadata.
.DS_Store
fixtures/windows.json
